# Uncomment the next line to define a global platform for your project
source 'https://github.com/CocoaPods/Specs.git'
#platform :ios, '9.0'
platform :ios, '15.0'

target 'FeasyWIFI' do
  # Uncomment the next line if you're using Swift or would like to use dynamic frameworks
  # use_frameworks!

  # Pods for FeasyWIFI
  pod 'CocoaAsyncSocket'
  pod 'AFNetworking', '4.0.1'
  pod 'SDWebImage', '5.16.0'
  pod 'SVProgressHUD', '2.0.3'
  pod 'Bugly', '2.5.90'
  pod 'Masonry', '1.1.0'
  pod 'MJRefresh', '3.1.10'
  pod 'MBProgressHUD', '1.1.0'

  target 'FeasyWIFIUITests' do
    inherit! :search_paths
    # Pods for testing



  end

end

post_install do |installer|
  installer.pods_project.targets.each do |t|
    t.build_configurations.each do |c|
      c.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      c.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
    end
  end

  Dir.glob('Pods/AFNetworking/**/*.m').each do |file|
    text = File.read(file)
    next unless text.include?('#import <netinet6/in6.h>')
    File.write(file, text.gsub('#import <netinet6/in6.h>', '#import <netinet/in.h>'))
  end
end
